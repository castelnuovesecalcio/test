{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/commerce/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/app/**",
              "ui_kits/web/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Brice|Brice SemiCondensed|Brice Condensed|Brice SemiExpanded|Brice Expanded|Inter Tight))/i]",
        "message": "Font not provided by the design system. Available: Brice, Brice SemiCondensed, Brice Condensed, Brice SemiExpanded, Brice Expanded, Inter Tight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|shape|tone|size|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: value, label, shape, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|rect|burst)$/]",
        "message": "<Badge> shape must be one of 'circle' | 'rect' | 'burst'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|inverse)$/]",
        "message": "<Badge> tone must be one of 'yellow' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|block|tilt|iconLeft|iconRight|as|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, block, tilt, iconLeft, iconRight, as, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|inverse|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'inverse' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|tone|shadow|square|interactive|media|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, title, tone, shadow, square, interactive, media."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|yellow|inverse)$/]",
        "message": "<Card> tone must be one of 'white' | 'yellow' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='shadow'] > Literal[value!=/^(?:sm|hard|none)$/]",
        "message": "<Card> shadow must be one of 'sm' | 'hard' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|children|actions|onClose|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, children, actions, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|wide|tone|tilt|treatment|stroke|press|as|key|ref|className|style|children)$/]",
        "message": "<Display> doesn't accept that prop. Declared props: children, level, wide, tone, tilt, treatment, stroke, press, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:black|yellow|white)$/]",
        "message": "<Display> tone must be one of 'black' | 'yellow' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute[name.name='treatment'] > Literal[value!=/^(?:outline|shadow|cast|cast-sm|cast-lg)$/]",
        "message": "<Display> treatment must be one of 'outline' | 'shadow' | 'cast' | 'cast-sm' | 'cast-lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|round|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, round, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|yellow|inverse|bare)$/]",
        "message": "<IconButton> variant must be one of 'default' | 'yellow' | 'inverse' | 'bare'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|width|basePath|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, width, basePath."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:badge|badgeBlack|badgeWhite|lockupBlack|stickerCircle|smashHand|tasteIt|burgerReloaded|mascot|claim)$/]",
        "message": "<Logo> variant must be one of 'badge' | 'badgeBlack' | 'badgeWhite' | 'lockupBlack' | 'stickerCircle' | 'smashHand' | 'tasteIt' | 'burgerReloaded' | 'mascot' | 'claim'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItemRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|image|imageAlt|tags|trailing|key|ref|className|style|children)$/]",
        "message": "<MenuItemRow> doesn't accept that prop. Declared props: name, description, price, image, imageAlt, tags, trailing."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|current|onClick|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href, current, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|price|oldPrice|image|imageAlt|tags|badge|actionLabel|onAction|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, description, price, oldPrice, image, imageAlt, tags, badge, actionLabel, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|sub|image|imageAlt|badge|ctaLabel|onCta|tone|key|ref|className|style|children)$/]",
        "message": "<PromoBanner> doesn't accept that prop. Declared props: headline, sub, image, imageAlt, badge, ctaLabel, onCta, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoBanner'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|inverse)$/]",
        "message": "<PromoBanner> tone must be one of 'yellow' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuantityStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|key|ref|className|style|children)$/]",
        "message": "<QuantityStepper> doesn't accept that prop. Declared props: value, min, max, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Starburst'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|tone|rotate|key|ref|className|style|children)$/]",
        "message": "<Starburst> doesn't accept that prop. Declared props: children, size, tone, rotate."
      },
      {
        "selector": "JSXOpeningElement[name.name='Starburst'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|inverse)$/]",
        "message": "<Starburst> tone must be one of 'yellow' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: label, checked, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|square|icon|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, square, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|yellow|inverse|positive|negative)$/]",
        "message": "<Tag> tone must be one of 'white' | 'yellow' | 'inverse' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|action|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, tone, icon, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:inverse|yellow|negative)$/]",
        "message": "<Toast> tone must be one of 'inverse' | 'yellow' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, children."
      }
    ]
  },
